{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--tool-timeout",
        "900",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    },
    "ast_grep": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp",
        "ast-grep-server"
      ],
      "enabled": true,
      "environment": {
        "AST_GREP_CONFIG": "sgconfig.yml"
      }
    }
  },
  "permission": {
    "serena*": "deny",
    "ast_grep*": "deny"
  },
  "provider": {
    "alibaba-token-plan-cn": {
      "models": {
        "qwen3.8-max-0902": {
          "name": "Qwen3.8 Max (0902)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "glm-5.3": {
          "name": "GLM-5.3",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "permission": {
        "serena*": "allow",
        "serena_search_for_pattern": "deny",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "ast_grep*": "allow"
      }
    },
    "plan": {
      "permission": {
        "serena*": "allow",
        "serena_search_for_pattern": "deny",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "ast_grep*": "allow"
      }
    }
  }
}
