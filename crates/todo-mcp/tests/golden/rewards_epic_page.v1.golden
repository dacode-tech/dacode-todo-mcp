<tbody><tr><td class="mono">U1</td><td>task</td><td class="st-closed">closed</td><td>Estimated small</td><td class="mono">S</td><td class="mono">S</td><td></td></tr><tr><td class="mono">U2</td><td>task</td><td class="st-closed">closed</td><td>Unestimated</td><td class="mono">-</td><td class="mono">M</td><td></td></tr></tbody></table>

