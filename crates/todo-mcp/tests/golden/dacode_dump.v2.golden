:U3"},{"shape":"task_to_task","from":"dacode:U20","to":"dacode:U21"},{"shape":"task_to_task","from":"dacode:U22","to":"dacode:U8"},{"shape":"decision_to_task","from":"dacode:D1","to":"dacode:U7"},{"shape":"decision_to_task","from":"dacode:D1","to":"dacode:U20"},{"shape":"decision_to_epic","from":"dacode:D1","to":"dacode:E1"},{"shape":"decision_to_epic","from":"dacode:D3","to":"dacode:E2"},{"shape":"decision_to_epic","from":"dacode:D4","to":"dacode:E4"}],"relates":[]}
