# ── Build output ────────────────────────────────────────────────────────
target/
tmp/

# ── Python tooling bytecode: tools/ is imported as well as run ──────────
__pycache__/
*.pyc

# ── Agent cache: renderings of committed state, never a source of it ────
.agents/cache/

# ── Personal override, untracked by design ──────────────────────────────
MYAGENTS.md

# ── opencode plugin deps ────────────────────────────────────────────────
.opencode/node_modules/
.opencode/package-lock.json
.opencode/bun.lock

# ── The store, once the server exists: user data, never repo content ────
*.todo-store
*.todo-log

# ── macOS ───────────────────────────────────────────────────────────────
.DS_Store
